# Copy this file to .env and fill only the provider(s) you use.
# Never commit the resulting .env file.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Local/remote OpenAI-compatible vLLM endpoint.
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=EMPTY

# Optional OpenRouter metadata.
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=SpikeSorting

# Optional JSON object passed to compatible VLM providers.
VLM_EXTRA_BODY_JSON=
